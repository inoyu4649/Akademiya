# ============================================================================
#  PyDe Web 환경변수 (pyde/.env)
# ============================================================================
#  ⚠️ .env는 git에 올리지 않는다. 서버에서 직접 작성할 것.

# 브라우저에서 본 PyDe의 오리진 — CSRF Origin 검사와 공유 링크 생성에 쓴다
PUBLIC_ORIGIN=https://pyde.akademiya.kr

# Akademiya 백엔드 API. 도커 컴포즈 안에서는 컨테이너 이름으로 접근한다
# (docker-compose.yml이 이 값을 http://backend:3000/api 로 주입한다)
AKADEMIYA_API_URL=http://backend:3000/api

# ── Akademiya OpenOAuth ─────────────────────────────────────────────────────
# akademiya.kr → 개발자 도구 → Akademiya OpenOAuth 에서 앱을 만들고 발급받는다.
#  · 신뢰 JavaScript 출처/리디렉션 URI에 아래 REDIRECT_URI를 정확히 등록할 것
#    (오리진만 등록해도 동작하지만 전체 URI 정확일치 등록을 권장 — L-8)
#  · 앱 설정의 선택 scope에서 **'Akademiya Cloud'를 반드시 켜야** 파일 저장이 동작한다.
#    끄면 서버가 INSUFFICIENT_SCOPE(403)를 돌려준다.
AKADEMIYA_OAUTH_CLIENT_ID=
AKADEMIYA_OAUTH_CLIENT_SECRET=
AKADEMIYA_OAUTH_AUTHORIZE_URL=https://akademiya.kr/oauth/authorize
AKADEMIYA_OAUTH_REDIRECT_URI=https://pyde.akademiya.kr/auth/callback

# ── 세션 쿠키 암호화 키 ──────────────────────────────────────────────────────
# openssl rand -hex 32
# ⚠️ 이 값을 바꾸면 기존 세션이 전부 무효가 되어 전원 재로그인이 필요하다.
PYDE_SESSION_SECRET=

# 포트 (docker-compose가 3002로 주입)
PORT=3002
