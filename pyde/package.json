{
  "name": "pydeweb",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PyDe Web - Pyodide 기반 교육용 Web Python IDE (Akademiya 부속 서비스)",
  "scripts": {
    "dev": "vite --host",
    "server": "tsx server/index.ts",
    "start": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "prod": "npm run build && tsx server/index.ts",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "axios": "^1.14.0",
    "concurrently": "^9.2.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "i18next": "^24.2.0",
    "i18next-browser-languagedetector": "^8.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^15.4.0",
    "react-router-dom": "^7.16.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "monaco-editor": "^0.52.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vite": "8.0.16"
  }
}
